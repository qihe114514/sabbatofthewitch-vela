<template>
  <div class="page">
    <text class="page-title">设置</text>
    <scroll class="content" scroll-y="true" bounces="true">
      <text class="label">显示速度 {{settings.textSpeed}}</text>
      <slider class="slider" min="0" max="50" step="5" value="{{settings.textSpeed}}" onchange="changeTextSpeed"></slider>
      <text class="hint">0 为立即显示</text>

      <text class="label size-label">文字大小 {{settings.textSize}}</text>
      <slider class="slider" min="20" max="36" step="2" value="{{settings.textSize}}" onchange="changeTextSize"></slider>

      <div class="preview-screen">
        <div class="preview-panel"></div>
        <text class="preview-name">其核</text>
        <scroll class="preview-scroll" scroll-y="true" bounces="false">
          <text class="preview-dialogue preview-dialogue-small" if="{{textSmall}}">这是一段较长的对白预览。文字大小会直接影响这里的显示效果，让你在进入故事前确认阅读时是否舒适。即使对白持续延伸，也可以在这个小窗口里查看行距和整体层次。</text>
          <text class="preview-dialogue preview-dialogue-medium" if="{{textMedium}}">这是一段较长的对白预览。文字大小会直接影响这里的显示效果，让你在进入故事前确认阅读时是否舒适。即使对白持续延伸，也可以在这个小窗口里查看行距和整体层次。</text>
          <text class="preview-dialogue preview-dialogue-large" if="{{textLarge}}">这是一段较长的对白预览。文字大小会直接影响这里的显示效果，让你在进入故事前确认阅读时是否舒适。即使对白持续延伸，也可以在这个小窗口里查看行距和整体层次。</text>
        </scroll>
      </div>
      <text class="label auto-label">自动阅读速度</text>
      <div class="speed-row">
        <text class="speed-option speed-selected" if="{{settings.autoPlaySpeed === 'slow'}}" @click="setAutoPlaySpeed('slow')">慢</text>
        <text class="speed-option" if="{{settings.autoPlaySpeed !== 'slow'}}" @click="setAutoPlaySpeed('slow')">慢</text>
        <text class="speed-option speed-selected" if="{{settings.autoPlaySpeed === 'medium'}}" @click="setAutoPlaySpeed('medium')">中</text>
        <text class="speed-option" if="{{settings.autoPlaySpeed !== 'medium'}}" @click="setAutoPlaySpeed('medium')">中</text>
        <text class="speed-option speed-selected" if="{{settings.autoPlaySpeed === 'fast'}}" @click="setAutoPlaySpeed('fast')">快</text>
        <text class="speed-option" if="{{settings.autoPlaySpeed !== 'fast'}}" @click="setAutoPlaySpeed('fast')">快</text>
      </div>
      <div class="actions">
        <text class="primary-btn" @click="saveSettings">保存</text>
        <text class="secondary-btn" @click="resetSettings">重置</text>
        <text class="about-btn" @click="openAbout">关于</text>
      </div>
    </scroll>
    <div class="footer-scrim"></div>
    <text class="back-btn" @click="back">返回</text>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import prompt from '@system.prompt'
import { DEFAULT_READER_SETTINGS, normalizeReaderSettings } from '../../common/reader-settings.js'

export default {
  private: { settings: DEFAULT_READER_SETTINGS, textSmall: true, textMedium: false, textLarge: false },
  onInit() {
    storage.get({
      key: 'settings',
      success: (data) => {
        try {
          const saved = JSON.parse(data)
          this.settings = normalizeReaderSettings(saved)
          this.setPreviewTextSize(this.settings.textSize)
        } catch (error) {}
      },
      fail: () => {}
    })
  },
  changeTextSpeed(event) { this.settings = Object.assign({}, this.settings, { textSpeed: event.progress }) },
  changeTextSize(event) { this.settings = Object.assign({}, this.settings, { textSize: event.progress }); this.setPreviewTextSize(event.progress) },
  setAutoPlaySpeed(speed) { this.settings = Object.assign({}, this.settings, { autoPlaySpeed: speed }) },
  resetSettings() { this.settings = Object.assign({}, DEFAULT_READER_SETTINGS); this.setPreviewTextSize(this.settings.textSize) },
  setPreviewTextSize(size) {
    const textSize = Number(size) || DEFAULT_READER_SETTINGS.textSize
    this.textSmall = textSize <= 22
    this.textMedium = textSize > 22 && textSize <= 30
    this.textLarge = textSize > 30
  },
  saveSettings() {
    this.settings = normalizeReaderSettings(this.settings)
    storage.set({
      key: 'settings',
      value: JSON.stringify(this.settings),
      success: () => prompt.showToast({ message: '设置已保存' }),
      fail: () => prompt.showToast({ message: '保存失败' })
    })
  },
  openAbout() { router.push({ uri: 'pages/about' }) },
  back() { router.back() }
}
</script>

<style>

.page { position: relative; width: 216px; height: 257px; overflow: hidden; background-color: #17151a; flex-direction: column; align-items: center; }
.page-title { position: absolute; top: 0px; left: 0px; width: 100%; height: 25.7px; line-height: 25.7px; color: #ffffff; font-size: 12.85px; font-weight: bold; text-align: center; }
.content { position: absolute; top: 27.68px; left: 0px; width: 216px; height: 201.65px; flex-direction: column; overflow: hidden; }
.label { width: 183.4px; height: 11.86px; line-height: 11.86px; margin-left: 16.3px; color: #ffffff; font-size: 9.88px; font-weight: bold; }
.slider { width: 183.4px; height: 14.83px; margin-left: 16.3px; color: #c75a84; }
.hint { width: 183.4px; height: 8.9px; line-height: 8.9px; margin-left: 16.3px; color: #bdb8bf; font-size: 6.92px; }
.size-label { margin-top: 3.95px; }
.auto-label { margin-top: 3.95px; }
.speed-row { width: 183.4px; height: 16.8px; margin-left: 16.3px; flex-direction: row; justify-content: space-between; }
.speed-option { width: 57.06px; height: 16.8px; line-height: 16.8px; background-color: #4a414b; color: #ffffff; font-size: 8.9px; font-weight: bold; text-align: center; border-radius: 3.95px; }
.speed-selected { background-color: #b95079; }
.preview-screen { position: relative; width: 216px; height: 51.4px; margin-top: 3.95px; }
.preview-panel { position: absolute; top: 0px; left: 0px; width: 216px; height: 51.4px; background-color: rgba(18,13,19,0.30); border-radius: 5.93px 5.93px 0px 0px; }
.preview-name { position: absolute; top: 3.95px; left: 10.19px; color: #ffd8e6; font-size: 9.88px; font-weight: bold; }
.preview-scroll { position: absolute; top: 17.79px; left: 0px; width: 216px; height: 31.63px; overflow: hidden; }
.preview-dialogue { width: 216px; color: #ffffff; font-weight: bold; line-height: 14.83px; }
.preview-dialogue-small { font-size: 9.88px; }
.preview-dialogue-medium { font-size: 11.86px; line-height: 16.8px; }
.preview-dialogue-large { font-size: 13.84px; line-height: 18.78px; }
.actions { width: 187.47px; height: 65.24px; margin: 6.92px 14.26px 11.86px; flex-direction: column; align-items: center; }
.primary-btn, .secondary-btn, .about-btn { width: 187.47px; height: 19.28px; line-height: 19.28px; color: #ffffff; font-size: 9.88px; font-weight: bold; text-align: center; border-radius: 4.45px; }
.primary-btn { background-color: #b95079; }
.secondary-btn, .about-btn { margin-top: 2.97px; background-color: #4a414b; }
.back-btn { position: absolute; bottom: 3.95px; left: 38.72px; width: 138.57px; height: 18.78px; line-height: 18.78px; color: #ffffff; font-size: 8.9px; font-weight: bold; text-align: center; background-color: #302b33; border-radius: 4.94px; z-index: 8; }
.footer-scrim { position: absolute; bottom: 0px; left: 0px; width: 216px; height: 31.63px; background-color: #17151a; z-index: 6; }
.page { width: 216px; height: 257px; }
  .page-title { height: 27.14px; line-height: 27.14px; font-size: 14.42px; }
  .content { top: 28.84px; height: 196.78px; }
  .label { width: 183.4px; height: 13.57px; line-height: 13.57px; margin-left: 16.3px; font-size: 11.87px; }
  .slider { width: 183.4px; height: 15.27px; margin-left: 16.3px; }
  .hint { width: 183.4px; height: 10.18px; line-height: 10.18px; margin-left: 16.3px; font-size: 8.48px; }
  .size-label { margin-top: 2.54px; }
  .auto-label { margin-top: 2.54px; }
  .speed-row { width: 183.4px; height: 16.96px; margin-left: 16.3px; }
  .speed-option { width: 57.06px; height: 16.96px; line-height: 16.96px; font-size: 11.03px; border-radius: 5.09px; }
  .preview-screen { width: 216px; height: 46.65px; margin-top: 2.54px; }
  .preview-panel { width: 216px; height: 46.65px; border-radius: 6.79px 6.79px 0px 0px; }
  .preview-name { top: 3.39px; left: 10.19px; font-size: 11.03px; }
  .preview-scroll { top: 18.66px; width: 216px; height: 24.6px; }
  .preview-dialogue { line-height: 13.57px; }
  .preview-dialogue-small { font-size: 9.33px; }
  .preview-dialogue-medium { font-size: 11.03px; line-height: 15.27px; }
  .preview-dialogue-large { font-size: 12.72px; line-height: 16.96px; }
  .actions { width: 187.47px; height: 81.43px; margin: 6.79px 14.26px 15.27px; flex-direction: column; }
  .primary-btn, .secondary-btn, .about-btn { width: 187.47px; height: 25.45px; line-height: 25.45px; font-size: 11.87px; border-radius: 5.94px; }
  .secondary-btn, .about-btn { margin-top: 2.54px; }
  .back-btn { bottom: 2.54px; left: 38.72px; width: 138.57px; height: 22.05px; line-height: 22.05px; font-size: 11.87px; border-radius: 6.79px; }
  .footer-scrim { height: 30.53px; }
.person-single { top: 2px; bottom: auto; left: -18.5px; width: 253px; height: 360px; }
.person-duo-left { top: 0px; bottom: auto; left: -53px; width: 224px; height: 360px; }
.person-duo-right { top: 0px; bottom: auto; left: 55px; width: 224px; height: 360px; }
.person-trio-left { top: 0px; bottom: auto; left: -61px; width: 209px; height: 342px; }
.person-trio-center { top: 0px; bottom: auto; left: 4px; width: 209px; height: 342px; }
.person-trio-right { top: 0px; bottom: auto; left: 69px; width: 209px; height: 342px; }
</style>

