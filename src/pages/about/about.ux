<template>
  <div class="page" @swipe="blockSystemBack">
    <text class="page-title">关于</text>
    <scroll class="content" scroll-y="true" bounces="true">
      <text class="game-title">{{title}}</text>
      <text class="game-subtitle">{{subtitle}}</text>

      <div class="info-row" for="{{infoRows}}">
        <text class="info-label">{{$item.label}}</text>
        <text class="info-value">{{$item.value}}</text>
      </div>

      <text class="section-title">故事介绍</text>
      <text class="intro-copy">{{intro}}</text>
      <text class="section-title">免责声明</text>
      <text class="intro-copy">{{disclaimer}}</text>
      <text class="section-title warning-title">R18警告</text>
      <text class="intro-copy warning-copy">{{r18Warning}}</text>
    </scroll>
    <text class="back-btn" @click="back">返回</text>
  </div>
</template>

<script>
import router from '@system.router'

export default {
  private: {
    title: '魔女的夜宴',
    subtitle: 'サノバウィッチ',
    infoRows: [
      { label: '原作开发', value: 'Yuzusoft（柚子社）' },
      { label: '移植作者', value: '@其核' },
      { label: '官方Q群', value: '1105166284' }
    ],
    intro: '保科咚史拥有一种不可思议的能力—\n他可以感知别人的心情。\n这件事一直以来都是他的秘密。\n而他的同班同学——绫地宁宁，\n也同样有着一个不可告人的秘密。\n他们俩本来只是普通同学。\n然而某一天，阴差阳错之下\n咚史撞见了令他难以置信的一幕。\n令人震惊的事件迅速拉近了两个人的距离，\n也让他们相互坦白了各自的秘密。\n这时咚史才终于知道，\n“魔女”究竟是怎样的存在..\n宁宁总是会突然“发作”，不分时间和地点。\n“魔女”必须掩人耳目，只能在秘密之中展开行动。\n随着两人关系的发展，\n学妹、学姐、转校生也接连不断地来到他们身边。\n原本风平浪静的校园生活突然变得忙碌起来\n这让咚史开始有了一丝期待。\n“改变自己的机会，也许就在眼前”',
    disclaimer: '本程序为个人非官方移植，仅供技术学习与交流使用。游戏内容、剧本与美术版权归原权利人所有，请支持正版，不得用于商业用途。',
    r18Warning: '本作含成人向、性暗示及不适合未成年人的内容。仅限18岁以上成年人使用，请遵守当地法律法规。'
  },
  back() { router.back() },
  blockSystemBack() {}
}
</script>

<style>

