.info-row { width: 199.7px; margin-top: 6.92px; flex-direction: row; align-items: flex-start; }
.info-label { width: 89.66px; color: #b95079; font-size: 7.41px; font-weight: bold; }
.info-value { flex: 1; color: #f5e1e8; font-size: 7.41px; font-weight: bold; line-height: 9.88px; }
.section-title { width: 199.7px; margin-top: 9.88px; padding-bottom: 1.98px; color: #ffffff; font-size: 8.9px; font-weight: bold; border-bottom: 1px solid #b95079; }
.intro-copy { width: 199.7px; margin-top: 4.94px; color: #e4c2cf; font-size: 8.4px; line-height: 12.36px; text-align: left; }
