<template>
  <div class="page" @swipe="blockSystemBack">
    <text class="page-title">{{isSaveMode ? '保存进度' : '读取进度'}}</text>
    <text class="page-subtitle">{{isSaveMode ? '点击覆盖，长按删除' : '点按读取，长按删除'}}</text>
    <list class="save-list" if="{{autoSaveData || saveRows.length || (isSaveMode && pendingSave)}}">
      <list-item type="auto" class="save-item auto-save-item" if="{{autoSaveData}}" @click="selectAutoSave">
        <text class="slot-title">自动存档</text>
        <div class="slot-meta">
          <text class="slot-info">{{autoSaveRow.info}}</text>
          <text class="slot-time">{{autoSaveRow.savedTime}}</text>
        </div>
      </list-item>
      <list-item type="save" class="save-item" for="{{saveRows}}" @click="selectSlot($idx)" @longpress="requestDeleteSlot($idx)">
        <text class="slot-title">存档 {{$idx + 1}}</text>
        <div class="slot-meta">
          <text class="slot-info">场景 {{$item.sceneNumber}}</text>
          <text class="slot-time">{{$item.savedTime}}</text>
        </div>
      </list-item>
      <list-item type="new" class="save-item add-item" if="{{isSaveMode && pendingSave}}" @click="saveNew">
        <text class="slot-title">新建存档</text>
      </list-item>
    </list>
    <div class="empty" if="{{!autoSaveData && !saveRows.length && !(isSaveMode && pendingSave)}}">
      <text class="empty-text">{{isSaveMode ? '还没有存档' : '暂无可读取的存档'}}</text>
    </div>
    <text class="back-btn" @click="back">返回</text>
    <div class="delete-scrim" if="{{deleteSlotIndex >= 0}}"></div>
    <div class="delete-dialog" if="{{deleteSlotIndex >= 0}}">
      <text class="delete-title">删除存档？</text>
      <text class="delete-copy">此操作无法撤销</text>
      <div class="delete-actions">
        <text class="delete-cancel" @click="cancelDelete">取消</text>
        <text class="delete-confirm" @click="confirmDelete">删除</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import prompt from '@system.prompt'

export default {
  protected: { mode: 'load' },
  private: { recoveryData: [], autoSaveData: null, autoSaveRow: { info: '', savedTime: '' }, saveRows: [], pendingSave: null, isSaveMode: false, deleteSlotIndex: -1, suppressedSlotClick: -1 },
  onInit() {
    this.isSaveMode = this.mode === 'save'
    storage.get({
      key: 'recoveryData',
      success: (data) => {
        try { this.recoveryData = Array.isArray(JSON.parse(data)) ? JSON.parse(data) : [] } catch (error) { this.recoveryData = [] }
        this.refreshSaveRows()
      },
      fail: () => { this.recoveryData = []; this.refreshSaveRows() }
    })
    storage.get({
      key: 'autoSave',
      success: (data) => {
        try {
          const saved = JSON.parse(data)
          this.autoSaveData = saved && saved.currentScnId ? saved : null
        } catch (error) { this.autoSaveData = null }
        this.refreshAutoSaveRow()
      },
      fail: () => { this.autoSaveData = null; this.refreshAutoSaveRow() }
    })
    if (this.isSaveMode) {
      storage.get({
        key: 'pendingSave',
        success: (data) => { try { this.pendingSave = JSON.parse(data) } catch (error) { this.pendingSave = null } },
        fail: () => { this.pendingSave = null }
      })
    }
  },
  selectSlot(index) {
    const slot = Number(index)
    if (slot === this.suppressedSlotClick) { this.suppressedSlotClick = -1; return }
    if (!Number.isInteger(slot) || slot < 0 || !this.recoveryData[slot] || (this.isSaveMode && !this.pendingSave)) return
    if (this.isSaveMode) return this.saveAt(slot)
    router.push({ uri: 'pages/detail', params: { load: String(slot) } })
  },
  selectAutoSave() {
    if (this.isSaveMode || !this.autoSaveData) return
    router.push({ uri: 'pages/detail', params: { auto: '1' } })
  },
  saveAt(slot) {
    if (!this.pendingSave) return prompt.showToast({ message: '当前进度不可保存' })
    const updated = this.recoveryData.slice()
    updated[slot] = this.freshPendingSave()
    this.persist(updated, '覆盖成功')
  },
  saveNew() {
    if (!this.pendingSave) return prompt.showToast({ message: '当前进度不可保存' })
    this.persist(this.recoveryData.concat([this.freshPendingSave()]), '保存成功')
  },
  requestDeleteSlot(index) {
    const slot = Number(index)
    if (!Number.isInteger(slot) || slot < 0 || !this.recoveryData[slot]) return
    this.suppressedSlotClick = slot
    this.deleteSlotIndex = slot
  },
  cancelDelete() { this.deleteSlotIndex = -1; this.suppressedSlotClick = -1 },
  confirmDelete() {
    const slot = this.deleteSlotIndex
    this.suppressedSlotClick = -1
    if (!Number.isInteger(slot) || slot < 0 || !this.recoveryData[slot]) return
    this.deleteSlotIndex = -1
    const updated = this.recoveryData.slice()
    updated.splice(slot, 1)
    storage.set({
      key: 'recoveryData',
      value: JSON.stringify(updated),
      success: () => { this.recoveryData = updated; this.refreshSaveRows(); prompt.showToast({ message: '已删除' }) },
      fail: () => prompt.showToast({ message: '删除失败' })
    })
  },
  persist(data, message) {
    storage.set({
      key: 'recoveryData',
      value: JSON.stringify(data),
      success: () => {
        this.recoveryData = data
        this.refreshSaveRows()
        prompt.showToast({ message })
      },
      fail: () => prompt.showToast({ message: '保存失败' })
    })
  },
  freshPendingSave() { return Object.assign({}, this.pendingSave, { savedAt: Date.now() }) },
  refreshSaveRows() {
    this.saveRows = (this.recoveryData || []).map((save) => ({
      sceneNumber: this.sceneLabel(save),
      savedTime: this.formatSavedAt(save && save.savedAt)
    }))
  },
  refreshAutoSaveRow() {
    const saved = this.autoSaveData
    const valid = saved && saved.currentScnId
    this.autoSaveRow = valid ? { info: this.sceneLabel(saved), savedTime: this.formatSavedAt(saved.savedAt) } : { info: '', savedTime: '' }
  },
  sceneLabel(save) { return save && save.currentScnId ? `场景 ${String(save.currentScnId).replace(/^0+/, '') || '0'}` : '未命名' },
  formatSavedAt(value) {
    const savedAt = Number(value)
    if (!Number.isFinite(savedAt) || savedAt <= 0) return '时间未知'
    const date = new Date(savedAt)
    const month = this.twoDigits(date.getMonth() + 1)
    const day = this.twoDigits(date.getDate())
    const hours = this.twoDigits(date.getHours())
    const minutes = this.twoDigits(date.getMinutes())
    return `${month}-${day} ${hours}:${minutes}`
  },
  twoDigits(value) { return value < 10 ? `0${value}` : String(value) },
  blockSystemBack() {},
  back() { storage.delete({ key: 'pendingSave', success: () => {}, fail: () => {} }); router.back() }
}
</script>

<style>

.page { position: relative; width: 240px; height: 240px; overflow: hidden; background-color: #17151a; flex-direction: column; align-items: center; }
.page-title { position: absolute; top: 0px; left: 0px; width: 100%; height: 24px; line-height: 24px; color: #ffffff; font-size: 12px; font-weight: bold; text-align: center; }
.page-subtitle { position: absolute; top: 24.92px; left: 18.11px; width: 203.77px; height: 11.08px; line-height: 11.08px; color: #c5bdc5; font-size: 7.85px; text-align: center; }
.save-list { position: absolute; top: 38.77px; left: 15.85px; width: 208.3px; height: 170.77px; }
.save-item { width: 208.3px; height: 28.62px; margin-bottom: 3.23px; padding: 0px 15.85px; background-color: #2c2730; flex-direction: row; align-items: center; justify-content: space-between; border-radius: 4.62px; }
.add-item { background-color: #b95079; align-items: center; justify-content: center; padding-left: 0px; }
.auto-save-item { background-color: #3b323b; }
.slot-title { color: #ffffff; font-size: 10.62px; font-weight: bold; }
.slot-meta { width: 90.57px; flex-direction: column; align-items: flex-end; }
.slot-info { width: 90.57px; color: #cfc6cf; font-size: 6.46px; text-overflow: ellipsis; lines: 1; text-align: right; }
.slot-time { color: #a9a1ab; font-size: 6px; margin-top: 1.38px; }
.empty { position: absolute; top: 38.77px; left: 15.85px; width: 208.3px; height: 170.77px; flex-direction: column; align-items: center; justify-content: center; }
.empty-text { color: #cfc6cf; font-size: 9.23px; text-align: center; }
.new-btn { width: 208.3px; height: 24px; line-height: 24px; margin-top: 9.23px; color: #ffffff; font-size: 9.69px; font-weight: bold; text-align: center; background-color: #b95079; border-radius: 4.62px; }
.back-btn { position: absolute; bottom: 3.69px; left: 43.02px; width: 153.96px; height: 17.54px; line-height: 17.54px; color: #ffffff; font-size: 8.31px; font-weight: bold; text-align: center; background-color: #302b33; border-radius: 4.62px; z-index: 8; }
.delete-scrim { position: absolute; top: 0px; left: 0px; width: 240px; height: 240px; background-color: #000000; opacity: 0.62; }
.delete-dialog { position: absolute; top: 84.92px; left: 22.64px; width: 163.02px; height: 70.15px; padding: 6.46px; background-color: #2c2730; border-radius: 6.46px; flex-direction: column; align-items: center; }
.delete-title { width: 163.02px; color: #ffffff; font-size: 10.15px; font-weight: bold; text-align: center; }
.delete-copy { width: 163.02px; margin-top: 3.69px; color: #cfc6cf; font-size: 6.92px; text-align: center; }
.delete-actions { width: 163.02px; height: 19.38px; margin-top: 9.23px; flex-direction: row; justify-content: space-between; }
.delete-cancel, .delete-confirm { width: 76.98px; height: 19.38px; line-height: 19.38px; color: #ffffff; font-size: 8.31px; font-weight: bold; text-align: center; border-radius: 4.62px; }
.delete-cancel { background-color: #4a414b; }
.delete-confirm { background-color: #b95079; }
.page { width: 240px; height: 240px; } .page-title { height: 31.93px; line-height: 31.93px; font-size: 16.48px; } .page-subtitle { width: 180.26px; height: 14.42px; line-height: 14.42px; font-size: 9.27px; } .save-list, .empty { width: 180.26px; height: 141.12px; margin-top: 2.06px; } .save-item { width: 180.26px; height: 29.87px; margin-bottom: 3.09px; padding: 0px 8.24px; border-radius: 7.21px; } .slot-title { font-size: 11.33px; } .slot-meta { width: 82.4px; } .slot-info { font-size: 9.27px; } .slot-time { font-size: 8.24px; } .new-btn { width: 154.51px; height: 26.78px; line-height: 26.78px; margin-top: 5.15px; font-size: 12.36px; } .back-btn { bottom: 3.09px; left: 29.87px; width: 180.26px; height: 25.75px; line-height: 25.75px; font-size: 11.33px; border-radius: 8.24px; } .delete-scrim { width: 240px; height: 240px; } .delete-dialog { top: 61.8px; left: 40.17px; width: 130.82px; height: 107.12px; padding: 14.42px; }
.person-single { top: 2px; bottom: auto; left: -20.4px; width: 280.8px; height: 360px; }
.person-duo-left { top: 0px; bottom: auto; left: -64.8px; width: 259.2px; height: 360px; }
.person-duo-right { top: 0px; bottom: auto; left: 64.8px; width: 259.2px; height: 360px; }
.person-trio-left { top: 0px; bottom: auto; left: -69.6px; width: 240.0px; height: 342px; }
.person-trio-center { top: 0px; bottom: auto; left: -4.8px; width: 240.0px; height: 342px; }
.person-trio-right { top: 0px; bottom: auto; left: 64.8px; width: 240.0px; height: 342px; }
</style>

