<template>
  <div class="page">
    <div class="page game-page" @click="handleGameClick" @longpress="enableUIHidden" if="{{!menu && recovery === 0 && !showChoice && !showEnd}}">
      <scroll id="bg-horizontal-scroll" scroll-x="false" scroll-y="false" bounces="false" class="background-scroll" if="{{Img && backgroundMode === 'horizontal'}}" @touchstart="blockBackgroundTouch" @touchmove="blockBackgroundTouch" @touchend="blockBackgroundTouch">
        <image class="background-horizontal" src="{{Img}}"></image>
      </scroll>
      <scroll id="bg-vertical-scroll" scroll-x="false" scroll-y="false" bounces="false" class="background-vertical-scroll" if="{{Img && backgroundMode === 'vertical'}}" @touchstart="blockBackgroundTouch" @touchmove="blockBackgroundTouch" @touchend="blockBackgroundTouch">
        <div class="background-vertical-track"><image class="background-vertical" src="{{Img}}"></image></div>
      </scroll>
      <image id="bg-static" class="background" src="{{Img}}" if="{{Img && !backgroundMode && !isCg}}" @touchstart="blockBackgroundTouch" @touchmove="blockBackgroundTouch" @touchend="blockBackgroundTouch"></image>
      <image class="cg-image" src="{{Img}}" if="{{Img && isCg}}" @swipe="blockSystemBack"></image>
      <div class="person-slot person-single" if="{{stageSingleBody && !isFullScreenCg}}" @swipe="blockSystemBack"><image class="person-layer" src="{{stageSingleBody}}"></image><image class="person-layer" src="{{stageSingleFace}}" if="{{stageSingleFace}}"></image></div>
      <div class="person-slot person-duo-left" if="{{stageDuoLeftBody && !isFullScreenCg}}" @swipe="blockSystemBack"><image class="person-layer" src="{{stageDuoLeftBody}}"></image><image class="person-layer" src="{{stageDuoLeftFace}}" if="{{stageDuoLeftFace}}"></image></div>
      <div class="person-slot person-duo-right" if="{{stageDuoRightBody && !isFullScreenCg}}" @swipe="blockSystemBack"><image class="person-layer" src="{{stageDuoRightBody}}"></image><image class="person-layer" src="{{stageDuoRightFace}}" if="{{stageDuoRightFace}}"></image></div>
      <div class="person-slot person-trio-left" if="{{stageTrioLeftBody && !isFullScreenCg}}" @swipe="blockSystemBack"><image class="person-layer" src="{{stageTrioLeftBody}}"></image><image class="person-layer" src="{{stageTrioLeftFace}}" if="{{stageTrioLeftFace}}"></image></div>
      <div class="person-slot person-trio-center" if="{{stageTrioCenterBody && !isFullScreenCg}}" @swipe="blockSystemBack"><image class="person-layer" src="{{stageTrioCenterBody}}"></image><image class="person-layer" src="{{stageTrioCenterFace}}" if="{{stageTrioCenterFace}}"></image></div>
      <div class="person-slot person-trio-right" if="{{stageTrioRightBody && !isFullScreenCg}}" @swipe="blockSystemBack"><image class="person-layer" src="{{stageTrioRightBody}}"></image><image class="person-layer" src="{{stageTrioRightFace}}" if="{{stageTrioRightFace}}"></image></div>
      <image class="stage-overlay" src="{{stageOverlayImage}}" if="{{stageOverlayImage && !isFullScreenCg}}" @swipe="blockSystemBack"></image>
      <div class="dialogue-panel" if="{{dialogueVisible && !isUIHidden}}" @swipe="blockSystemBack"></div>
      <text class="character-name" if="{{dialogueVisible && !isUIHidden}}" @swipe="blockSystemBack">{{character}}</text>
      <scroll scroll-y="true" bounces="true" class="scroll" id="scroll" if="{{dialogueVisible && !isUIHidden}}" @swipe="blockSystemBack">
        <div class="dialogue-content">
          <text class="dialogue-text dialogue-text-small" if="{{textSmall}}">{{showText}}</text>
          <text class="dialogue-text dialogue-text-medium" if="{{textMedium}}">{{showText}}</text>
          <text class="dialogue-text dialogue-text-large" if="{{textLarge}}">{{showText}}</text>
        </div>
      </scroll>
    </div>

    <div class="choice-page" if="{{showChoice}}" @swipe="blockSystemBack">
      <scroll scroll-y="true" bounces="true" class="choice-list">
        <div class="choice-grid">
          <text class="choice" for="{{choices}}" @click="selectChoice($idx)">{{$item.text}}</text>
        </div>
      </scroll>
      <div class="menu-trigger-hit" @click="openMenu"><div class="menu-trigger"><div class="menu-bar menu-bar-top"></div><div class="menu-bar menu-bar-middle"></div><div class="menu-bar menu-bar-bottom"></div></div></div>
    </div>

    <div class="menu-trigger-hit" if="{{!menu && recovery === 0 && !showEnd && !showChoice && !isUIHidden}}" @click="openMenu"><div class="menu-trigger"><div class="menu-bar menu-bar-top"></div><div class="menu-bar menu-bar-middle"></div><div class="menu-bar menu-bar-bottom"></div></div></div>

    <div class="page menu-page" if="{{menu}}" @swipe="back">
      <text class="menu-heading">阅读菜单</text>
      <div class="menu-status">
        <text class="chapter-label">{{chapterLabel}}</text>
        <text class="scene-progress">{{sceneProgress}}</text>
      </div>
      <text class="menu-btn menu-primary" @click="openSavePage">保存进度</text>
      <text class="menu-btn" @click="openLoadPage">读取存档</text>
      <text class="menu-btn" @click="skipToOptions">跳过场景</text>
      <text class="menu-btn" @click="skipChapter">跳过章节</text>
      <text class="menu-btn" @click="toggleAutoPlay">{{autoPlayLabel}}</text>
      <div class="menu-row">
        <text class="menu-small-btn" @click="openSettingsPage">设置</text>
        <text class="menu-small-btn" @click="back('e')">主页</text>
      </div>
      <text class="menu-close" @click="closeMenu">返回阅读</text>
    </div>

    <div class="page end-page" if="{{showEnd}}" @swipe="back">
      <text class="end-title">达成结局</text>
      <text class="end-text">{{END}}</text>
      <text class="end-action" @click="back('e')">返回主页</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import prompt from '@system.prompt'
import file from '@system.file'
import { SCN_TYPE, SETTINGS_KEY, STORY_DIR } from '../../common/reader-constants.js'
import { resolveBackground, resolveEvent, resolveCharacterLayers, setResourceManifest } from '../../common/resource-resolver.js'
import { runtimeData, loadRuntimeData, loadSceneAssets, clearSceneAssets } from '../../common/runtime-data.js'
import { DEFAULT_READER_SETTINGS, normalizeReaderSettings, getAutoAdvanceDelay } from '../../common/reader-settings.js'
import { toDisplayCharacterName } from '../../common/display-names.js'
import engine from './scriptEngine.js'

export default {
  ...engine,
  protected: { auto: '', load: '' },
  private: {
    scriptData: [], currentScnId: '001', currentLineIndex: 0, index: 0, currentCharIndex: 0,
    Img: '', backgroundMode: '', isCg: false, isFullScreenCg: false, cgGroup: '', cgSrc: '', currentEvent: '',
    showText: '', typingText: '', character: '', settings: DEFAULT_READER_SETTINGS, textSize: 22,
    textSmall: true, textMedium: false, textLarge: false,
    stageSingleBody: '', stageSingleFace: '', stageDuoLeftBody: '', stageDuoLeftFace: '', stageDuoRightBody: '', stageDuoRightFace: '', stageTrioLeftBody: '', stageTrioLeftFace: '', stageTrioCenterBody: '', stageTrioCenterFace: '', stageTrioRightBody: '', stageTrioRightFace: '', stageOverlayImage: '', sceneOverlayImage: '', centerOverlayImage: '', topRightOverlayImage: '',
    currentBg: '', currentCharacters: null, currentSpeaker: '', fullText: '', autoPlay: false, autoPlayLabel: '自动播放：关', autoPlayTimer: 0,
    choices: [], dialogueVisible: false, showChoice: false, showEnd: false,
    chapter: 0, chapterLabel: '第1章', sceneProgress: '场景 1', menu: false, recovery: 0,
    gameFlags: {}, currentChapterName: '', isUIHidden: false, suppressHiddenClick: false, canContinue: true,
    recoveryData: [], missingVisuals: {}, END: '', loading: false, typingToken: 0, backgroundMotionToken: 0, cgToken: 0, sceneLoadToken: 0,
    dialoguesSinceAutoSave: 0, autoSaveWriteWarned: false, autoSaveDirty: false, lastAutoSaveSignature: '', pendingAutoSaveSignature: ''
  },

  onInit() {
    this.loadSettings()
    this.initializeGame()
  },

  initializeGame() {
    const loadRequestedState = () => {
      if (this.auto !== '1') return this.loadData()
      storage.get({
        key: 'autoSave',
        success: (data) => {
          try {
            const saved = JSON.parse(data)
            if (saved && saved.currentScnId) this.restoreData(saved)
          } catch (error) {}
          this.loadData()
        },
        fail: () => this.loadData()
      })
    }
    loadRuntimeData((uri, options) => file.readText({ uri, ...options }), (error) => {
      if (error) {
        prompt.showToast({ message: '资源索引读取失败' })
        return
      }
      storage.get({
      key: 'recoveryData',
      success: (data) => {
        try {
          const parsed = JSON.parse(data)
          this.recoveryData = Array.isArray(parsed) ? parsed : []
        } catch (error) { this.recoveryData = [] }
        const rawLoad = this.load
        if (rawLoad !== undefined && rawLoad !== null && rawLoad !== '') {
          const slot = Number(rawLoad)
          if (!Number.isInteger(slot) || slot < 0 || !this.recoveryData[slot]) {
            prompt.showToast({ message: '存档不存在' })
            return
          }
          this.restoreData(this.recoveryData[slot])
          this.loadData()
          return
        }
        loadRequestedState()
      },
      fail: () => loadRequestedState()
      })
    })
  },

  onShow() { this.loadSettings(); this.restartBackgroundMotion() },
  onHide() { this.persistAutoSave(true); this.typingToken += 1; this.cgToken += 1; this.stopBackgroundMotion(); this.clearAutoPlayTimer() },
  onDestroy() { this.persistAutoSave(true); this.typingToken += 1; this.cgToken += 1; this.stopBackgroundMotion(); this.clearAutoPlayTimer() },

  loadSettings() {
    storage.get({ key: SETTINGS_KEY, success: (data) => {
      try {
        const saved = JSON.parse(data)
        this.settings = normalizeReaderSettings(saved)
        this.autoPlay = Boolean(this.settings.autoPlay)
        this.autoPlayLabel = this.autoPlay ? '自动播放：开' : '自动播放：关'
        this.setTextSize(this.settings.textSize)
      } catch (error) {}
    }, fail: () => {} })
  },

  getPathById(id) {
    return runtimeData.scenePathById[id]
  },

  loadData() {
    this.loadScenario(this.currentScnId, this.currentLineIndex)
  },

  loadScenario(id, startIndex = 0) {
    const fileName = this.getPathById(id)
    if (!fileName) return prompt.showToast({ message: '场景未找到' })
    this.loading = true
    const token = ++this.sceneLoadToken
    this.stopBackgroundMotion()
    this.clearAutoPlayTimer()
    this.scriptData = []
    this.currentCharacters = null
    this.clearStageCharacters()
    this.Img = ''
    this.backgroundMode = ''
    this.isCg = false
    this.isFullScreenCg = false
    this.stageOverlayImage = ''
    clearSceneAssets()
    setTimeout(() => {
      if (token !== this.sceneLoadToken) return
      loadSceneAssets((uri, options) => file.readText({ uri, ...options }), id, (assetError) => {
        if (token !== this.sceneLoadToken) return
        if (assetError) { this.loading = false; return prompt.showToast({ message: '场景资源读取失败' }) }
        setResourceManifest(runtimeData.resourceManifest)
        file.readText({
          uri: `${STORY_DIR}/${fileName}`,
          success: (data) => {
            if (token !== this.sceneLoadToken) return
            try {
              this.scriptData = JSON.parse(data.text)
              this.currentScnId = id
              this.currentLineIndex = parseInt(startIndex, 10) || 0
              this.loading = false
              this.renderCurrentLine()
            } catch (e) { this.loading = false; prompt.showToast({ message: '剧本解析失败' }) }
          },
          fail: () => { if (token === this.sceneLoadToken) { this.loading = false; prompt.showToast({ message: '剧本读取失败' }) } }
        })
      })
    }, 0)
  },

  // 渲染当前指令：应用背景/立绘/CG，并显示对白
  renderCurrentLine() {
    let guard = 0
    while (this.scriptData && this.currentLineIndex < this.scriptData.length && guard < 64) {
      const node = this.scriptData[this.currentLineIndex]
      const type = node[0]
      const content = node[1]
      guard += 1
      switch (type) {
      case SCN_TYPE.BACKGROUND:
        this.currentBg = content
        this.currentEvent = ''
        this.stageOverlayImage = ''
        this.applyStage()
        this.markAutoSaveDirty()
        this.currentLineIndex++
        continue
      case SCN_TYPE.DIALOGUE: {
        this.currentSpeaker = content || ''
        this.fullText = node[2] || ''
        if (node.length > 3) this.currentCharacters = Array.isArray(node[3]) ? node[3] : []
        this.applyStage()
        this.character = toDisplayCharacterName(this.currentSpeaker)
        this.dialoguesSinceAutoSave += 1
        this.markAutoSaveDirty()
        if (this.dialoguesSinceAutoSave >= 10) this.persistAutoSave(false)
        this.showDialogue(this.fullText)
        return
      }
      case SCN_TYPE.SELECT:
        this.persistAutoSave(true)
        this.showChoice = true
        this.choices = content.map((item) => ({ text: item[0], targetLabel: item[1], exp: item[2] }))
        this.dialogueVisible = true
        return
      case SCN_TYPE.CHAPTER_TITLE:
        this.currentChapterName = content
        this.chapterLabel = content
        this.currentLineIndex++
        continue
      case SCN_TYPE.LABEL:
        this.currentLineIndex++
        continue
      case SCN_TYPE.NEXT:
        this.jumpToLabel(content)
        return
      case SCN_TYPE.EV:
        if (!content) {
          this.currentEvent = ''
          this.stageOverlayImage = ''
          this.applyStage()
        } else if (String(content).startsWith('ch_')) {
          this.stageOverlayImage = this.resolveVisual('overlay', content)
        } else {
          this.currentEvent = content
          this.applyStage()
        }
        this.currentLineIndex++
        continue
      default:
        this.currentLineIndex++
        continue
      }
    }
    if (!this.scriptData || this.currentLineIndex >= this.scriptData.length) this.goToNextScenario()
    else if (guard >= 64) setTimeout(() => this.renderCurrentLine(), 0)
  },

  jumpToLabel(targetLabel) {
    const jumpIndex = this.scriptData.findIndex((item) => item[0] === SCN_TYPE.LABEL && item[1] === targetLabel)
    if (jumpIndex !== -1) {
      this.currentLineIndex = jumpIndex
      this.renderCurrentLine()
    } else {
      this.currentLineIndex++
      this.renderCurrentLine()
    }
  },

  // 应用背景/立绘/CG 到母本 UI 图层
  applyStage() {
    const rawBackground = this.currentEvent || this.currentBg
    const isCg = rawBackground && (String(rawBackground).startsWith('ev') || String(rawBackground).startsWith('sd'))
    const isFull = isCg && String(rawBackground).startsWith('ev')
    const background = isCg ? this.resolveVisual('event', rawBackground) : this.resolveVisual('background', rawBackground)
    this.showBackground(background, isCg ? '' : 'horizontal', isCg ? background : null, isFull)
    if (Array.isArray(this.currentCharacters) && this.currentCharacters.length) {
      const imgs = this.currentCharacters.map((item) => {
        if (!Array.isArray(item)) return ''
        return resolveCharacterLayers(item[0], item[2], item[3], runtimeData.characterMap, runtimeData.characterFaceMap) || this.missingVisual('character', `${item[0]}|${item[2] || ''}|${item[3] || ''}`)
      }).filter(Boolean)
      this.applyStageLayout(this.stageLayout(imgs))
    } else this.clearStageCharacters()
  },

  clearStageCharacters() {
    this.applyStageLayout({ stageSingleBody: '', stageSingleFace: '', stageDuoLeftBody: '', stageDuoLeftFace: '', stageDuoRightBody: '', stageDuoRightFace: '', stageTrioLeftBody: '', stageTrioLeftFace: '', stageTrioCenterBody: '', stageTrioCenterFace: '', stageTrioRightBody: '', stageTrioRightFace: '' })
  },

  applyStageLayout(layout) {
    Object.keys(layout).forEach((key) => { if (this[key] !== layout[key]) this[key] = layout[key] })
  },

  resolveVisual(type, value) {
    const resolved = type === 'background' ? resolveBackground(value) : type === 'overlay' ? resolveEvent(value) : resolveEvent(value)
    if (value && !resolved) return this.missingVisual(type, value)
    return resolved
  },

  missingVisual(type, value) {
    const key = `${type}:${value}`
    if (!this.missingVisuals[key]) {
      this.missingVisuals[key] = true
      prompt.showToast({ message: `缺少资源：${value}` })
    }
    return ''
  },

  showBackground(image, motion, cgImage, isFullScreenCg) {
    const isCg = Boolean(cgImage)
    const cgGroup = isCg ? String(cgImage).split('_')[0] : ''
    if (this.Img === image && this.backgroundMode === motion && this.isCg === isCg && this.isFullScreenCg === isFullScreenCg) return
    this.Img = image || ''
    this.backgroundMode = motion || ''
    this.isCg = isCg
    this.isFullScreenCg = Boolean(isFullScreenCg)
    this.cgGroup = cgGroup
    this.cgToken += 1
    this.stopBackgroundMotion()
    if (!isCg && motion === 'horizontal') this.startBackgroundMotion(motion)
  },

  stopBackgroundMotion() { this.backgroundMotionToken += 1 },
  restartBackgroundMotion() {
    if (this.isCg || !this.Img || !this.backgroundMode) return
    this.stopBackgroundMotion()
    this.startBackgroundMotion(this.backgroundMode)
  },
  startBackgroundMotion(motion) {
    const token = this.backgroundMotionToken
    if (motion === 'horizontal') return this.startHorizontalBackgroundMotion(token)
    return this.startVerticalBackgroundMotion(token)
  },
  scrollBackground(id, left, top) {
    try {
      const element = this.$element(id)
      if (!element || typeof element.scrollTo !== 'function') return false
      element.scrollTo({ left, top, behavior: 'instant' })
      return true
    } catch (error) { return false }
  },
  startHorizontalBackgroundMotion(token) {
    const travel = 212
    const duration = 5000
    const move = (from, to) => {
      const startedAt = Date.now()
      const tick = () => {
        if (token !== this.backgroundMotionToken) return
        const progress = Math.min(1, (Date.now() - startedAt) / duration)
        const left = Math.round(from + (to - from) * progress)
        this.scrollBackground('bg-horizontal-scroll', left, 0)
        if (progress < 1) return setTimeout(tick, 50)
        move(to, from)
      }
      tick()
    }
    setTimeout(() => move(0, travel), 0)
  },
  startVerticalBackgroundMotion(token) {
    const travel = 8
    const duration = 5000
    const move = (from, to) => {
      const startedAt = Date.now()
      const tick = () => {
        if (token !== this.backgroundMotionToken) return
        const progress = Math.min(1, (Date.now() - startedAt) / duration)
        const top = Math.round(from + (to - from) * progress)
        this.scrollBackground('bg-vertical-scroll', 0, top)
        if (progress < 1) return setTimeout(tick, 50)
        move(to, from)
      }
      tick()
    }
    setTimeout(() => move(0, travel), 0)
  },

  showDialogue(text) {
    this.clearAutoPlayTimer()
    this.typingToken += 1
    this.typingText = text || ''
    this.showText = ''
    this.dialogueVisible = true
    this.canContinue = false
    this.index = 0
    if (this.settings.textSpeed === 0) { this.finishTyping(); return }
    this.zhuzi(this.typingToken)
  },
  zhuzi(token) {
    if (token !== this.typingToken) return
    const speed = Number(this.settings.textSpeed) || 0
    if (speed <= 0) return this.finishTyping(token)
    const elapsed = Math.max(0, Date.now() - (this.typingStartedAt || Date.now()))
    if (!this.typingStartedAt) this.typingStartedAt = Date.now() - (this.index || 0) * speed
    this.index = Math.min(this.typingText.length, Math.max(this.index + 1, Math.floor(elapsed / speed) + 1))
    this.showText = this.typingText.slice(0, this.index)
    if (this.index >= this.typingText.length) return this.finishTyping(token)
    setTimeout(() => this.zhuzi(token), 50)
  },
  finishTyping(token) {
    if (token !== undefined && token !== this.typingToken) return
    this.typingToken += 1
    this.typingStartedAt = 0
    this.showText = this.typingText
    this.index = this.typingText.length
    this.canContinue = true
    this.scheduleAutoPlay()
  },
  clearAutoPlayTimer() {
    if (this.autoPlayTimer) {
      clearTimeout(this.autoPlayTimer)
      this.autoPlayTimer = 0
    }
  },
  scheduleAutoPlay() {
    this.clearAutoPlayTimer()
    if (!this.autoPlay || !this.canContinue || this.showChoice || this.showEnd || this.menu) return
    const delay = getAutoAdvanceDelay(this.typingText, this.settings.autoPlaySpeed)
    this.autoPlayTimer = setTimeout(() => {
      this.autoPlayTimer = 0
      if (this.autoPlay && this.canContinue && !this.menu && !this.showChoice && !this.showEnd) this.nextLine()
    }, delay)
  },
  toggleAutoPlay() {
    this.autoPlay = !this.autoPlay
    this.settings = Object.assign({}, this.settings, { autoPlay: this.autoPlay })
    storage.set({ key: SETTINGS_KEY, value: JSON.stringify(this.settings) })
    this.autoPlayLabel = this.autoPlay ? '自动播放：开' : '自动播放：关'
    if (this.autoPlay) {
      this.menu = false
      if (this.canContinue) this.scheduleAutoPlay()
    } else this.clearAutoPlayTimer()
  },
  setTextSize(size) {
    this.textSize = Number(size) || 22
    this.textSmall = this.textSize <= 22
    this.textMedium = this.textSize > 22 && this.textSize <= 30
    this.textLarge = this.textSize > 30
  },
  stageLayout(imgs) {
    const layout = { stageSingleBody: '', stageSingleFace: '', stageDuoLeftBody: '', stageDuoLeftFace: '', stageDuoRightBody: '', stageDuoRightFace: '', stageTrioLeftBody: '', stageTrioLeftFace: '', stageTrioCenterBody: '', stageTrioCenterFace: '', stageTrioRightBody: '', stageTrioRightFace: '' }
    const count = imgs.length
    const assign = (prefix, image) => { layout[`${prefix}Body`] = image && image.body || ''; layout[`${prefix}Face`] = image && image.face || '' }
    if (count === 1) assign('stageSingle', imgs[0])
    else if (count === 2) { assign('stageDuoLeft', imgs[0]); assign('stageDuoRight', imgs[1]) }
    else if (count === 3) { assign('stageTrioLeft', imgs[0]); assign('stageTrioCenter', imgs[1]); assign('stageTrioRight', imgs[2]) }
    return layout
  },

  nextLine() {
    if (this.loading || this.showChoice || this.END) return
    this.clearAutoPlayTimer()
    if (!this.canContinue) return this.finishTyping()
    this.scrollToTop()
    this.currentLineIndex++
    this.renderCurrentLine()
  },

  goToNextScenario() {
    const next = this.getNextScn(this.currentScnId)
    if (next) { this.persistAutoSave(true); this.currentScnId = next.id; this.loadScenario(next.id) }
    else { this.persistAutoSave(true); this.END = '游戏结束'; this.showEnd = true; this.dialogueVisible = false }
  },

  selectChoice(index) {
    const choice = this.choices[index]
    if (!choice) return
    if (choice.exp) this.runExp(choice.exp)
    this.markAutoSaveDirty()
    this.persistAutoSave(true)
    this.showChoice = false
    this.jumpToLabel(choice.targetLabel)
  },

  blockSystemBack() {},
  blockBackgroundTouch() {},
  openMenu() { if (!this.showEnd && this.recovery === 0) { this.menu = true; this.clearAutoPlayTimer() } },
  closeMenu() { this.menu = false; if (this.canContinue) this.scheduleAutoPlay() },
  back(action) {
    if ((action && (action.direction === 'left' || action.direction === 'right')) || action === 'c') {
      if (this.recovery !== 0) this.recovery = 0
      else if (this.menu) { this.menu = false; if (this.canContinue) this.scheduleAutoPlay() }
    }
    else if (action === 'e') { this.persistAutoSave(true); router.replace({ uri: 'pages/index' }) }
  },
  scrollToTop() { this.$element('scroll').scrollTo({ top: 0, left: 0, behavior: 'instant' }) },

  openSavePage() {
    this.persistAutoSave(true)
    const pendingSave = this.buildSaveData()
    this.menu = false
    storage.set({ key: 'pendingSave', value: JSON.stringify(pendingSave), success: () => router.replace({ uri: 'pages/saves', params: { mode: 'save', resume: '1' } }), fail: () => prompt.showToast({ message: '无法准备存档' }) })
  },
  openLoadPage() { this.persistAutoSave(true); this.menu = false; router.replace({ uri: 'pages/saves', params: { mode: 'load', resume: '1' } }) },
  openSettingsPage() { this.persistAutoSave(true); this.menu = false; router.push({ uri: 'pages/settings' }) },
  markAutoSaveDirty() { this.autoSaveDirty = true },
  persistAutoSave(force) {
    if (!this.currentScnId || this.loading || !this.autoSaveDirty || (!force && this.dialoguesSinceAutoSave < 10)) return
    const data = this.buildSaveData()
    const signature = this.buildAutoSaveSignature(data)
    this.dialoguesSinceAutoSave = 0
    if (signature === this.lastAutoSaveSignature || signature === this.pendingAutoSaveSignature) { this.autoSaveDirty = false; return }
    this.autoSaveDirty = false
    this.pendingAutoSaveSignature = signature
    storage.set({ key: 'autoSave', value: JSON.stringify(data), success: () => {
      if (this.pendingAutoSaveSignature === signature) this.pendingAutoSaveSignature = ''
      this.lastAutoSaveSignature = signature
    }, fail: () => {
      if (this.pendingAutoSaveSignature === signature) this.pendingAutoSaveSignature = ''
      this.autoSaveDirty = true
      if (!this.autoSaveWriteWarned) { this.autoSaveWriteWarned = true; prompt.showToast({ message: '自动存档失败' }) }
    } })
  },
  buildSaveData() {
    return { storyId: 'sanoba-witch', currentScnId: this.currentScnId, currentLineIndex: this.currentLineIndex, currentBg: this.currentBg, currentEvent: this.currentEvent, currentChapterName: this.currentChapterName, gameFlags: Object.assign({}, this.gameFlags), savedAt: Date.now(), settings: Object.assign({}, this.settings, { autoPlay: this.autoPlay }) }
  },
  buildAutoSaveSignature(data) {
    return JSON.stringify({ storyId: data.storyId, currentScnId: data.currentScnId, currentLineIndex: data.currentLineIndex, currentBg: data.currentBg, currentEvent: data.currentEvent, currentChapterName: data.currentChapterName, gameFlags: data.gameFlags, settings: data.settings })
  },
  restoreData(data) {
    this.currentScnId = (data && data.currentScnId) || '001'
    this.currentLineIndex = parseInt(data && data.currentLineIndex, 10) || 0
    this.currentBg = (data && data.currentBg) || ''
    this.currentEvent = (data && data.currentEvent) || ''
    this.currentChapterName = (data && data.currentChapterName) || ''
    this.gameFlags = (data && data.gameFlags) || {}
    const saved = data && data.settings ? data.settings : {}
    this.settings = normalizeReaderSettings(Object.assign({}, this.settings, saved))
    this.autoPlay = Boolean(this.settings.autoPlay)
    this.autoPlayLabel = this.autoPlay ? '自动播放：开' : '自动播放：关'
    this.setTextSize(this.settings.textSize)
    this.lastAutoSaveSignature = this.buildAutoSaveSignature(this.buildSaveData())
    this.autoSaveDirty = false
  },

  handleGameClick() {
    if (this.suppressHiddenClick) { this.suppressHiddenClick = false; return }
    if (this.isUIHidden) { this.isUIHidden = false; return }
    this.nextLine()
  },
  enableUIHidden() { this.isUIHidden = true; this.suppressHiddenClick = true },

  skipToOptions() {
    this.menu = false
    this.skipUntilBackground()
  },

  skipChapter() {
    this.persistAutoSave(true)
    this.menu = false
    const next = this.getNextScn(this.currentScnId)
    if (!next) return prompt.showToast({ message: '没有可跳过的章节' })
    this.currentScnId = next.id
    this.loadScenario(next.id)
  },

  // 借用 engine 的快进/规则方法
  skipUntilBackground() {
    if (!this.scriptData || this.scriptData.length === 0) return
    let guard = 0
    let found = -1
    for (let i = this.currentLineIndex + 1; i < this.scriptData.length && guard < 10000; i += 1, guard += 1) {
      if (this.scriptData[i][0] === SCN_TYPE.BACKGROUND) { found = i; break }
    }
    if (found >= 0) {
      this.persistAutoSave(true)
      this.currentLineIndex = found
      this.renderCurrentLine()
      return
    }
    if (this.currentLineIndex >= this.scriptData.length || guard >= 10000) {
      this.persistAutoSave(true)
      this.goToNextScenario()
      return
    }
    while (this.currentLineIndex < this.scriptData.length && guard < 10000) {
      const node = this.scriptData[this.currentLineIndex]
      const type = node[0]
      const content = node[1]
      if (type === SCN_TYPE.SELECT) { this.renderCurrentLine(); return }
      if (type === SCN_TYPE.DIALOGUE) { this.currentSpeaker = content || ''; this.fullText = node[2] || '' }
      if (type === SCN_TYPE.BACKGROUND) { this.currentBg = content; this.currentEvent = ''; this.renderCurrentLine(); return }
      if (type === SCN_TYPE.CHAPTER_TITLE) this.currentChapterName = content
      this.currentLineIndex++
      guard++
    }
    if (this.currentLineIndex >= this.scriptData.length) this.goToNextScenario()
  }
}
</script>

