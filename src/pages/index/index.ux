<template>
  <div class="page" @swipe="ban">
    <image id="home-bg" static class="home-background" src="/common/images/cover.png"></image>
    <image static class="home-logo" src="/common/images/logo.png"></image>
    <text class="game-title">{{title}}</text>

    <div class="home-panel">
      <text class="resume-copy">{{resumeCopy}}</text>
      <text class="primary-action" @click="continueGame">{{primaryAction}}</text>
      <div class="secondary-row">
        <text class="secondary-action" @click="startGame">新游戏</text>
        <text class="secondary-action" @click="openSaves">存档</text>
      </div>
      <div class="action-row">
        <text class="compact-action" @click="openSettings">设置</text>
        <text class="compact-action" @click="openGallery">CG</text>
      </div>
      <text class="exit-action" @click="exit">退出</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import game from '../../common/game-config.js'

export default {
  private: { title: game.title, autoSaveData: null, resumeCopy: '新的故事即将开始', primaryAction: '开始阅读' },
  onInit() { this.refreshAutoSave() },
  onShow() { this.refreshAutoSave() },
  refreshAutoSave() {
    this.autoSaveData = null
    storage.get({
      key: 'autoSave',
      success: (data) => {
        try {
          const saved = JSON.parse(data)
          if (saved && saved.currentScnId) this.autoSaveData = saved
        } catch (error) {}
        this.refreshResumeState()
      },
      fail: () => this.refreshResumeState()
    })
  },
  refreshResumeState() {
    if (this.autoSaveData) {
      this.resumeCopy = `进度 · ${this.autoSaveData.currentChapterName || '共通篇'}`
      this.primaryAction = '继续阅读'
      return
    }
    this.resumeCopy = '新的故事即将开始'
    this.primaryAction = '开始阅读'
  },
  continueGame() {
    if (this.autoSaveData) return router.push({ uri: 'pages/detail', params: { auto: '1' } })
    this.startGame()
  },
  startGame() { router.push({ uri: 'pages/detail' }) },
  openSaves() { router.push({ uri: 'pages/saves', params: { mode: 'load' } }) },
  openSettings() { router.push({ uri: 'pages/settings' }) },
  openGallery() { router.push({ uri: 'pages/gallery' }) },
  exit() { this.$app.exit() },
  ban() {}
}
</script>

<style>
.page { width: 212px; height: 520px; overflow: hidden; background-color: #160f16; }
.home-background { position: absolute; top: 0px; left: 0px; width: 212px; height: 520px; object-fit: cover; }
.home-logo { position: absolute; top: 96px; left: 16px; width: 180px; height: 102px; object-fit: contain; }
.game-title { position: absolute; top: 190px; left: 16px; width: 180px; color: #ffffff; font-size: 24px; font-weight: bold; text-align: center; }
.home-panel { position: absolute; top: 284px; left: 0px; width: 212px; height: 236px; background-color: rgba(23,17,25,0.94); border-radius: 14px 14px 0px 0px; flex-direction: column; align-items: center; }
.resume-copy { width: 212px; height: 20px; margin-top: 8px; color: #f5e1e8; font-size: 16px; font-weight: bold; text-align: center; text-overflow: ellipsis; lines: 1; }
.primary-action { width: 176px; height: 50px; margin-top: 8px; background-color: #b95079; color: #ffffff; font-size: 24px; font-weight: bold; text-align: center; border-radius: 10px; }
.secondary-row { width: 176px; height: 38px; margin-top: 6px; flex-direction: row; justify-content: space-between; }
.secondary-action { width: 84px; height: 38px; background-color: #412536; color: #ffffff; font-size: 19px; font-weight: bold; text-align: center; border-radius: 10px; }
.action-row { width: 176px; height: 38px; margin-top: 6px; flex-direction: row; justify-content: space-between; }
.compact-action { width: 84px; height: 38px; background-color: #412536; color: #ffffff; font-size: 19px; font-weight: bold; text-align: center; border-radius: 10px; }
.exit-action { width: 176px; height: 40px; margin-top: 8px; background-color: #302b33; color: #ffffff; font-size: 21px; font-weight: bold; text-align: center; border-radius: 10px; }

@media (shape: rect) {
  .page { width: 212px; height: 303px; }
  .home-background { width: 212px; height: 303px; }
  .home-logo { top: 18px; left: 36px; width: 140px; height: 80px; }
  .game-title { top: 88px; left: 16px; width: 180px; font-size: 16px; }
  .home-panel { top: 118px; width: 212px; height: 185px; border-radius: 12px 12px 0px 0px; }
  .resume-copy { width: 188px; height: 16px; margin-top: 6px; }
  .primary-action { width: 164px; height: 38px; margin-top: 6px; font-size: 16px; }
  .secondary-row, .action-row { width: 164px; height: 30px; margin-top: 5px; }
  .secondary-action, .compact-action { width: 78px; height: 30px; font-size: 13px; border-radius: 8px; }
  .exit-action { width: 164px; height: 30px; margin-top: 6px; font-size: 14px; border-radius: 8px; }
}
</style>
