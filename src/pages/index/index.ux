<template>
  <div class="page" @swipe="ban">
    <image id="home-bg" static class="home-background" src="/common/images/cover.png"></image>
    <image static class="home-logo" src="/common/images/logo.png"></image>
    <text class="game-title">{{title}}</text>

    <div class="home-panel">
      <text class="resume-copy">{{resumeCopy}}</text>
      <text class="primary-action" @click="continueGame">{{primaryAction}}</text>
      <div class="secondary-row">
        <text class="secondary-action" @click="startGame">新游戏</text>
        <text class="secondary-action" @click="openSaves">存档</text>
      </div>
      <div class="action-row">
        <text class="compact-action" @click="openSettings">设置</text>
        <text class="compact-action" @click="openGallery">CG</text>
      </div>
      <text class="exit-action" @click="exit">退出</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import game from '../../common/game-config.js'

export default {
  private: { title: game.title, autoSaveData: null, resumeCopy: '新的故事即将开始', primaryAction: '开始阅读' },
  onInit() { this.refreshAutoSave() },
  onShow() { this.refreshAutoSave() },
  refreshAutoSave() {
    this.autoSaveData = null
    storage.get({
      key: 'autoSave',
      success: (data) => {
        try {
          const saved = JSON.parse(data)
          if (saved && saved.currentScnId) this.autoSaveData = saved
        } catch (error) {}
        this.refreshResumeState()
      },
      fail: () => this.refreshResumeState()
    })
  },
  refreshResumeState() {
    if (this.autoSaveData) {
      this.resumeCopy = `进度 · ${this.autoSaveData.currentChapterName || '共通篇'}`
      this.primaryAction = '继续阅读'
      return
    }
    this.resumeCopy = '新的故事即将开始'
    this.primaryAction = '开始阅读'
  },
  continueGame() {
    if (this.autoSaveData) return router.push({ uri: 'pages/detail', params: { auto: '1' } })
    this.startGame()
  },
  startGame() { router.push({ uri: 'pages/detail' }) },
  openSaves() { router.push({ uri: 'pages/saves', params: { mode: 'load' } }) },
  openSettings() { router.push({ uri: 'pages/settings' }) },
  openGallery() { router.push({ uri: 'pages/gallery' }) },
  exit() { this.$app.exit() },
  ban() {}
}
</script>

<style>

.page { width: 216px; height: 257px; overflow: hidden; background-color: #160f16; }
.home-background { position: absolute; top: 0px; left: 0px; width: 216px; height: 257px; object-fit: cover; }
.home-logo { position: absolute; top: 47.45px; left: 16.3px; width: 183.4px; height: 50.41px; object-fit: contain; }
.game-title { position: absolute; top: 93.9px; left: 16.3px; width: 183.4px; color: #ffffff; font-size: 11.86px; font-weight: bold; text-align: center; }
.home-panel { position: absolute; top: 140.36px; left: 0px; width: 216px; height: 116.64px; background-color: rgba(23,17,25,0.94); border-radius: 6.92px 6.92px 0px 0px; flex-direction: column; align-items: center; }
.resume-copy { width: 216px; height: 9.88px; margin-top: 3.95px; color: #f5e1e8; font-size: 7.91px; font-weight: bold; text-align: center; text-overflow: ellipsis; lines: 1; }
.primary-action { width: 179.32px; height: 24.71px; margin-top: 3.95px; background-color: #b95079; color: #ffffff; font-size: 11.86px; font-weight: bold; text-align: center; border-radius: 4.94px; }
.secondary-row { width: 179.32px; height: 18.78px; margin-top: 2.97px; flex-direction: row; justify-content: space-between; }
.secondary-action { width: 85.58px; height: 18.78px; background-color: #412536; color: #ffffff; font-size: 9.39px; font-weight: bold; text-align: center; border-radius: 4.94px; }
.action-row { width: 179.32px; height: 18.78px; margin-top: 2.97px; flex-direction: row; justify-content: space-between; }
.compact-action { width: 85.58px; height: 18.78px; background-color: #412536; color: #ffffff; font-size: 9.39px; font-weight: bold; text-align: center; border-radius: 4.94px; }
.exit-action { width: 179.32px; height: 19.77px; margin-top: 3.95px; background-color: #302b33; color: #ffffff; font-size: 10.38px; font-weight: bold; text-align: center; border-radius: 4.94px; }
.page { width: 216px; height: 257px; }
  .home-background { width: 216px; height: 257px; }
  .home-logo { top: 15.27px; left: 36.68px; width: 142.64px; height: 67.85px; }
  .game-title { top: 74.64px; left: 16.3px; width: 183.4px; font-size: 13.57px; }
  .home-panel { top: 100.09px; width: 216px; height: 156.91px; border-radius: 10.18px 10.18px 0px 0px; }
  .resume-copy { width: 191.55px; height: 13.57px; margin-top: 5.09px; }
  .primary-action { width: 167.09px; height: 32.23px; margin-top: 5.09px; font-size: 13.57px; }
  .secondary-row, .action-row { width: 167.09px; height: 25.45px; margin-top: 4.24px; }
  .secondary-action, .compact-action { width: 79.47px; height: 25.45px; font-size: 11.03px; border-radius: 6.79px; }
  .exit-action { width: 167.09px; height: 25.45px; margin-top: 5.09px; font-size: 11.87px; border-radius: 6.79px; }
.person-single { top: 2px; bottom: auto; left: -18.5px; width: 253px; height: 360px; }
.person-duo-left { top: 0px; bottom: auto; left: -53px; width: 224px; height: 360px; }
.person-duo-right { top: 0px; bottom: auto; left: 55px; width: 224px; height: 360px; }
.person-trio-left { top: 0px; bottom: auto; left: -61px; width: 209px; height: 342px; }
.person-trio-center { top: 0px; bottom: auto; left: 4px; width: 209px; height: 342px; }
.person-trio-right { top: 0px; bottom: auto; left: 69px; width: 209px; height: 342px; }
</style>
