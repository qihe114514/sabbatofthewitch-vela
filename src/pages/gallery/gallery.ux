<template>
  <div class="page" @swipe="blockSystemBack">
    <text class="page-title">CG鉴赏</text>
    <text class="chapter-picker" @click="togglePicker">章节：{{selectedGroup ? selectedGroup.title : '选择章节'}}</text>
    <list class="content">
      <list-item type="group" class="group-title-item" if="{{selectedGroup}}"><text class="group-title">{{selectedGroup.title}}</text></list-item>
      <list-item type="thumb" class="thumb-row" for="{{rows}}">
        <div class="thumb-cell" if="{{$item.leftTitle}}" @click="openItem($item.leftGroupId, $item.leftIndex)">
          <image class="thumb" src="{{$item.leftSrc}}" if="{{$item.leftSrc}}"></image>
          <text class="thumb-empty" if="{{!$item.leftSrc}}">暂无图像</text>
          <text class="thumb-title">{{$item.leftTitle}}</text>
        </div>
        <div class="thumb-cell" if="{{$item.rightTitle}}" @click="openItem($item.rightGroupId, $item.rightIndex)">
          <image class="thumb" src="{{$item.rightSrc}}" if="{{$item.rightSrc}}"></image>
          <text class="thumb-empty" if="{{!$item.rightSrc}}">暂无图像</text>
          <text class="thumb-title">{{$item.rightTitle}}</text>
        </div>
      </list-item>
    </list>
    <text class="back-btn" @click="back">返回</text>
    <div class="picker-scrim" if="{{pickerVisible}}" @click="togglePicker"></div>
    <div class="picker" if="{{pickerVisible}}">
      <text class="picker-title">选择章节</text>
      <text class="picker-option" for="{{groups}}" @click="selectGroup($idx)">{{$item.title}}</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { getCgGroups } from '../../common/cg-catalog.js'

function makeRows(group) {
  const rows = []
  for (let index = 0; index < group.items.length; index += 2) {
    const left = group.items[index]
    const right = group.items[index + 1]
    rows.push({ leftGroupId: group.id, leftIndex: index, leftSrc: left.src, leftTitle: left.title, rightGroupId: group.id, rightIndex: index + 1, rightSrc: right ? right.src : '', rightTitle: right ? right.title : '' })
  }
  return rows
}

export default {
  private: { groups: [], selectedGroup: null, rows: [], pickerVisible: false },
  onInit() { this.groups = getCgGroups(); this.selectGroup(0) },
  selectGroup(index) {
    const group = this.groups[Number(index)]
    if (!group) return
    this.selectedGroup = group
    this.rows = makeRows(group)
    this.pickerVisible = false
  },
  togglePicker() { this.pickerVisible = !this.pickerVisible },
  openItem(groupId, index) { router.push({ uri: 'pages/cg-viewer', params: { groupId, index: String(index) } }) },
  back() { router.back() },
  blockSystemBack() {}
}
</script>

<style>

.page { width: 240px; height: 240px; overflow: hidden; background-color: #17151a; flex-direction: column; align-items: center; }
.page-title { position: absolute; top: 0px; left: 0px; width: 240px; height: 24px; line-height: 24px; color: #ffffff; font-size: 12.46px; font-weight: bold; text-align: center; }
.chapter-picker { position: absolute; top: 24.92px; left: 15.85px; width: 208.3px; height: 19.38px; line-height: 19.38px; background-color: #b95079; color: #ffffff; font-size: 8.77px; font-weight: bold; text-align: center; border-radius: 4.62px; }
.content { position: absolute; top: 47.08px; left: 9.06px; width: 221.89px; height: 165.23px; overflow: hidden; }
.group-title-item { width: 221.89px; height: 13.85px; }
.group-title { width: 221.89px; height: 13.85px; line-height: 13.85px; color: #e08db1; font-size: 9.23px; font-weight: bold; }
.thumb-row { width: 221.89px; height: 56.31px; margin-top: 3.69px; flex-direction: row; justify-content: space-between; }
.thumb-cell { width: 106.42px; height: 56.31px; background-color: #2c2730; border-radius: 3.23px; flex-direction: column; align-items: center; }
.thumb { width: 101.89px; height: 43.38px; margin-top: 0.92px; object-fit: contain; }
.thumb-empty { width: 101.89px; height: 43.38px; margin-top: 0.92px; line-height: 43.38px; color: #aaa1aa; font-size: 6px; text-align: center; }
.thumb-title { width: 101.89px; height: 11.08px; line-height: 11.08px; color: #f5e1e8; font-size: 6px; text-align: center; text-overflow: ellipsis; lines: 1; }
.back-btn { position: absolute; bottom: 3.69px; left: 43.02px; width: 153.96px; height: 17.54px; line-height: 17.54px; color: #ffffff; font-size: 8.31px; font-weight: bold; text-align: center; background-color: #302b33; border-radius: 4.62px; z-index: 8; }
.picker-scrim { position: absolute; top: 0px; left: 0px; width: 240px; height: 240px; background-color: #000000; opacity: 0.72; }
.picker { position: absolute; top: 26.77px; left: 18.11px; width: 203.77px; padding: 4.62px 0px; background-color: #2c2730; border-radius: 5.54px; flex-direction: column; align-items: center; }
.picker-title { width: 181.13px; height: 12.92px; line-height: 12.92px; color: #ffd8e6; font-size: 8.77px; font-weight: bold; text-align: center; }
.picker-option { width: 181.13px; height: 15.69px; line-height: 15.69px; margin-top: 1.85px; background-color: #412536; color: #ffffff; font-size: 7.85px; font-weight: bold; text-align: center; border-radius: 3.69px; }
.back-btn { bottom: 3.09px; left: 29.87px; width: 180.26px; height: 25.75px; line-height: 25.75px; font-size: 11.33px; border-radius: 8.24px; }
.person-single { top: 2px; bottom: auto; left: -20.4px; width: 280.8px; height: 360px; }
.person-duo-left { top: 0px; bottom: auto; left: -64.8px; width: 259.2px; height: 360px; }
.person-duo-right { top: 0px; bottom: auto; left: 64.8px; width: 259.2px; height: 360px; }
.person-trio-left { top: 0px; bottom: auto; left: -69.6px; width: 240.0px; height: 342px; }
.person-trio-center { top: 0px; bottom: auto; left: -4.8px; width: 240.0px; height: 342px; }
.person-trio-right { top: 0px; bottom: auto; left: 64.8px; width: 240.0px; height: 342px; }
</style>
