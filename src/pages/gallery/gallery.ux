<template>
  <div class="page" @swipe="blockSystemBack">
    <text class="page-title">CG鉴赏</text>
    <text class="chapter-picker" @click="togglePicker">章节：{{selectedGroup ? selectedGroup.title : '选择章节'}}</text>
    <list class="content">
      <list-item type="group" class="group-title-item" if="{{selectedGroup}}"><text class="group-title">{{selectedGroup.title}}</text></list-item>
      <list-item type="thumb" class="thumb-row" for="{{rows}}">
        <div class="thumb-cell" if="{{$item.leftTitle}}" @click="openItem($item.leftGroupId, $item.leftIndex)">
          <image class="thumb" src="{{$item.leftSrc}}" if="{{$item.leftSrc}}"></image>
          <text class="thumb-empty" if="{{!$item.leftSrc}}">暂无图像</text>
          <text class="thumb-title">{{$item.leftTitle}}</text>
        </div>
        <div class="thumb-cell" if="{{$item.rightTitle}}" @click="openItem($item.rightGroupId, $item.rightIndex)">
          <image class="thumb" src="{{$item.rightSrc}}" if="{{$item.rightSrc}}"></image>
          <text class="thumb-empty" if="{{!$item.rightSrc}}">暂无图像</text>
          <text class="thumb-title">{{$item.rightTitle}}</text>
        </div>
      </list-item>
    </list>
    <text class="back-btn" @click="back">返回</text>
    <div class="picker-scrim" if="{{pickerVisible}}" @click="togglePicker"></div>
    <div class="picker" if="{{pickerVisible}}">
      <text class="picker-title">选择章节</text>
      <text class="picker-option" for="{{groups}}" @click="selectGroup($idx)">{{$item.title}}</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { getCgGroups } from '../../common/cg-catalog.js'

function makeRows(group) {
  const rows = []
  for (let index = 0; index < group.items.length; index += 2) {
    const left = group.items[index]
    const right = group.items[index + 1]
    rows.push({ leftGroupId: group.id, leftIndex: index, leftSrc: left.src, leftTitle: left.title, rightGroupId: group.id, rightIndex: index + 1, rightSrc: right ? right.src : '', rightTitle: right ? right.title : '' })
  }
  return rows
}

export default {
  private: { groups: [], selectedGroup: null, rows: [], pickerVisible: false },
  onInit() { this.groups = getCgGroups(); this.selectGroup(0) },
  selectGroup(index) {
    const group = this.groups[Number(index)]
    if (!group) return
    this.selectedGroup = group
    this.rows = makeRows(group)
    this.pickerVisible = false
  },
  togglePicker() { this.pickerVisible = !this.pickerVisible },
  openItem(groupId, index) { router.push({ uri: 'pages/cg-viewer', params: { groupId, index: String(index) } }) },
  back() { router.back() },
  blockSystemBack() {}
}
</script>

<style>

.page { width: 96px; height: 245px; overflow: hidden; background-color: #17151a; flex-direction: column; align-items: center; }
.page-title { position: absolute; top: 0px; left: 0px; width: 96px; height: 24.5px; line-height: 23.55px; color: #ffffff; font-size: 12.23px; font-weight: bold; text-align: center; }
.chapter-picker { position: absolute; top: 25.44px; left: 6.34px; width: 83.32px; height: 19.79px; line-height: 19.02px; background-color: #b95079; color: #ffffff; font-size: 8.6px; font-weight: bold; text-align: center; border-radius: 4.53px; }
.content { position: absolute; top: 48.06px; left: 3.62px; width: 88.75px; height: 168.67px; overflow: hidden; }
.group-title-item { width: 88.75px; height: 14.13px; }
.group-title { width: 88.75px; height: 14.13px; line-height: 13.58px; color: #e08db1; font-size: 9.06px; font-weight: bold; }
.thumb-row { width: 88.75px; height: 57.48px; margin-top: 3.77px; flex-direction: row; justify-content: space-between; }
.thumb-cell { width: 42.57px; height: 57.48px; background-color: #2c2730; border-radius: 3.17px; flex-direction: column; align-items: center; }
.thumb { width: 40.75px; height: 44.29px; margin-top: 0.94px; object-fit: contain; }
.thumb-empty { width: 40.75px; height: 44.29px; margin-top: 0.94px; line-height: 42.57px; color: #aaa1aa; font-size: 5.89px; text-align: center; }
.thumb-title { width: 40.75px; height: 11.31px; line-height: 10.87px; color: #f5e1e8; font-size: 5.89px; text-align: center; text-overflow: ellipsis; lines: 1; }
.back-btn { position: absolute; bottom: 3.77px; left: 17.21px; width: 61.58px; height: 17.9px; line-height: 17.21px; color: #ffffff; font-size: 8.15px; font-weight: bold; text-align: center; background-color: #302b33; border-radius: 4.53px; z-index: 8; }
.picker-scrim { position: absolute; top: 0px; left: 0px; width: 96px; height: 245px; background-color: #000000; opacity: 0.72; }
.picker { position: absolute; top: 27.33px; left: 7.25px; width: 81.51px; padding: 4.71px 0px; background-color: #2c2730; border-radius: 5.43px; flex-direction: column; align-items: center; }
.picker-title { width: 72.45px; height: 13.19px; line-height: 12.68px; color: #ffd8e6; font-size: 8.6px; font-weight: bold; text-align: center; }
.picker-option { width: 72.45px; height: 16.02px; line-height: 15.4px; margin-top: 1.88px; background-color: #412536; color: #ffffff; font-size: 7.7px; font-weight: bold; text-align: center; border-radius: 3.62px; }
.person-single { top: 2px; bottom: auto; left: -8.0px; width: 112px; height: 360px; }
.person-duo-left { top: 0px; bottom: auto; left: -26px; width: 104px; height: 340px; }
.person-duo-right { top: 0px; bottom: auto; left: 26px; width: 104px; height: 340px; }
.person-trio-left { top: 0px; bottom: auto; left: -31px; width: 100px; height: 330px; }
.person-trio-center { top: 0px; bottom: auto; left: -2px; width: 100px; height: 330px; }
.person-trio-right { top: 0px; bottom: auto; left: 27px; width: 100px; height: 330px; }
</style>


