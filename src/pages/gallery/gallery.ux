<template>
  <div class="page" @swipe="blockSystemBack">
    <text class="page-title">CG鉴赏</text>
    <text class="chapter-picker" @click="togglePicker">章节：{{selectedGroup ? selectedGroup.title : '选择章节'}}</text>
    <list class="content">
      <list-item type="group" class="group-title-item" if="{{selectedGroup}}"><text class="group-title">{{selectedGroup.title}}</text></list-item>
      <list-item type="thumb" class="thumb-row" for="{{rows}}">
        <div class="thumb-cell" if="{{$item.leftTitle}}" @click="openItem($item.leftGroupId, $item.leftIndex)">
          <image class="thumb" src="{{$item.leftSrc}}" if="{{$item.leftSrc}}"></image>
          <text class="thumb-empty" if="{{!$item.leftSrc}}">暂无图像</text>
          <text class="thumb-title">{{$item.leftTitle}}</text>
        </div>
        <div class="thumb-cell" if="{{$item.rightTitle}}" @click="openItem($item.rightGroupId, $item.rightIndex)">
          <image class="thumb" src="{{$item.rightSrc}}" if="{{$item.rightSrc}}"></image>
          <text class="thumb-empty" if="{{!$item.rightSrc}}">暂无图像</text>
          <text class="thumb-title">{{$item.rightTitle}}</text>
        </div>
      </list-item>
    </list>
    <text class="back-btn" @click="back">返回</text>
    <div class="picker-scrim" if="{{pickerVisible}}" @click="togglePicker"></div>
    <div class="picker" if="{{pickerVisible}}">
      <text class="picker-title">选择章节</text>
      <text class="picker-option" for="{{groups}}" @click="selectGroup($idx)">{{$item.title}}</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { getCgGroups } from '../../common/cg-catalog.js'

function makeRows(group) {
  const rows = []
  for (let index = 0; index < group.items.length; index += 2) {
    const left = group.items[index]
    const right = group.items[index + 1]
    rows.push({ leftGroupId: group.id, leftIndex: index, leftSrc: left.src, leftTitle: left.title, rightGroupId: group.id, rightIndex: index + 1, rightSrc: right ? right.src : '', rightTitle: right ? right.title : '' })
  }
  return rows
}

export default {
  private: { groups: [], selectedGroup: null, rows: [], pickerVisible: false },
  onInit() { this.groups = getCgGroups(); this.selectGroup(0) },
  selectGroup(index) {
    const group = this.groups[Number(index)]
    if (!group) return
    this.selectedGroup = group
    this.rows = makeRows(group)
    this.pickerVisible = false
  },
  togglePicker() { this.pickerVisible = !this.pickerVisible },
  openItem(groupId, index) { router.push({ uri: 'pages/cg-viewer', params: { groupId, index: String(index) } }) },
  back() { router.back() },
  blockSystemBack() {}
}
</script>

<style>

.page { width: 216px; height: 257px; overflow: hidden; background-color: #17151a; flex-direction: column; align-items: center; }
.page-title { position: absolute; top: 0px; left: 0px; width: 216px; height: 25.7px; line-height: 25.7px; color: #ffffff; font-size: 13.34px; font-weight: bold; text-align: center; }
.chapter-picker { position: absolute; top: 26.69px; left: 14.26px; width: 187.47px; height: 20.76px; line-height: 20.76px; background-color: #b95079; color: #ffffff; font-size: 9.39px; font-weight: bold; text-align: center; border-radius: 4.94px; }
.content { position: absolute; top: 50.41px; left: 8.15px; width: 199.7px; height: 176.93px; overflow: hidden; }
.group-title-item { width: 199.7px; height: 14.83px; }
.group-title { width: 199.7px; height: 14.83px; line-height: 14.83px; color: #e08db1; font-size: 9.88px; font-weight: bold; }
.thumb-row { width: 199.7px; height: 60.3px; margin-top: 3.95px; flex-direction: row; justify-content: space-between; }
.thumb-cell { width: 95.77px; height: 60.3px; background-color: #2c2730; border-radius: 3.46px; flex-direction: column; align-items: center; }
.thumb { width: 91.7px; height: 46.46px; margin-top: 0.99px; object-fit: contain; }
.thumb-empty { width: 91.7px; height: 46.46px; margin-top: 0.99px; line-height: 46.46px; color: #aaa1aa; font-size: 6.43px; text-align: center; }
.thumb-title { width: 91.7px; height: 11.86px; line-height: 11.86px; color: #f5e1e8; font-size: 6.43px; text-align: center; text-overflow: ellipsis; lines: 1; }
.back-btn { position: absolute; bottom: 3.95px; left: 38.72px; width: 138.57px; height: 18.78px; line-height: 18.78px; color: #ffffff; font-size: 8.9px; font-weight: bold; text-align: center; background-color: #302b33; border-radius: 4.94px; z-index: 8; }
.picker-scrim { position: absolute; top: 0px; left: 0px; width: 216px; height: 257px; background-color: #000000; opacity: 0.72; }
.picker { position: absolute; top: 28.67px; left: 16.3px; width: 183.4px; padding: 4.94px 0px; background-color: #2c2730; border-radius: 5.93px; flex-direction: column; align-items: center; }
.picker-title { width: 163.02px; height: 13.84px; line-height: 13.84px; color: #ffd8e6; font-size: 9.39px; font-weight: bold; text-align: center; }
.picker-option { width: 163.02px; height: 16.8px; line-height: 16.8px; margin-top: 1.98px; background-color: #412536; color: #ffffff; font-size: 8.4px; font-weight: bold; text-align: center; border-radius: 3.95px; }
.page { width: 216px; height: 257px; }
  .page-title { height: 26.29px; line-height: 26.29px; font-size: 16.12px; }
  .chapter-picker { top: 27.99px; height: 22.05px; line-height: 22.05px; font-size: 11.87px; }
  .content { top: 53.44px; height: 173.03px; }
  .group-title-item, .group-title { height: 16.12px; }
  .group-title { line-height: 16.12px; font-size: 11.87px; }
  .thumb-row { height: 57.68px; margin-top: 3.39px; }
  .thumb-cell { height: 57.68px; }
  .thumb { height: 41.56px; }
  .thumb-empty { height: 41.56px; line-height: 41.56px; font-size: 7.63px; }
  .thumb-title { height: 12.72px; line-height: 12.72px; font-size: 7.63px; }
  .back-btn { bottom: 2.54px; left: 38.72px; width: 138.57px; height: 22.05px; line-height: 22.05px; font-size: 11.87px; border-radius: 6.79px; }
  .picker-scrim { height: 257px; }
  .picker { top: 30.53px; }
  .picker-title { height: 18.66px; line-height: 18.66px; font-size: 12.72px; }
  .picker-option { height: 18.66px; line-height: 18.66px; font-size: 11.03px; }
.person-single { top: 2px; bottom: auto; left: -18.5px; width: 253px; height: 360px; }
.person-duo-left { top: 0px; bottom: auto; left: -53px; width: 224px; height: 360px; }
.person-duo-right { top: 0px; bottom: auto; left: 55px; width: 224px; height: 360px; }
.person-trio-left { top: 0px; bottom: auto; left: -61px; width: 209px; height: 342px; }
.person-trio-center { top: 0px; bottom: auto; left: 4px; width: 209px; height: 342px; }
.person-trio-right { top: 0px; bottom: auto; left: 69px; width: 209px; height: 342px; }
</style>
