<template>
  <div class="page" @swipe="blockSystemBack">
    <text class="page-title">CG鉴赏</text>
    <text class="chapter-picker" @click="togglePicker">章节：{{selectedGroup ? selectedGroup.title : '选择章节'}}</text>
    <list class="content">
      <list-item type="group" class="group-title-item" if="{{selectedGroup}}"><text class="group-title">{{selectedGroup.title}}</text></list-item>
      <list-item type="thumb" class="thumb-row" for="{{rows}}">
        <div class="thumb-cell" if="{{$item.leftTitle}}" @click="openItem($item.leftGroupId, $item.leftIndex)">
          <image class="thumb" src="{{$item.leftSrc}}" if="{{$item.leftSrc}}"></image>
          <text class="thumb-empty" if="{{!$item.leftSrc}}">暂无图像</text>
          <text class="thumb-title">{{$item.leftTitle}}</text>
        </div>
        <div class="thumb-cell" if="{{$item.rightTitle}}" @click="openItem($item.rightGroupId, $item.rightIndex)">
          <image class="thumb" src="{{$item.rightSrc}}" if="{{$item.rightSrc}}"></image>
          <text class="thumb-empty" if="{{!$item.rightSrc}}">暂无图像</text>
          <text class="thumb-title">{{$item.rightTitle}}</text>
        </div>
      </list-item>
    </list>
    <text class="back-btn" @click="back">返回</text>
    <div class="picker-scrim" if="{{pickerVisible}}" @click="togglePicker"></div>
    <div class="picker" if="{{pickerVisible}}">
      <text class="picker-title">选择章节</text>
      <text class="picker-option" for="{{groups}}" @click="selectGroup($idx)">{{$item.title}}</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { getCgGroups } from '../../common/cg-catalog.js'

function makeRows(group) {
  const rows = []
  for (let index = 0; index < group.items.length; index += 2) {
    const left = group.items[index]
    const right = group.items[index + 1]
    rows.push({ leftGroupId: group.id, leftIndex: index, leftSrc: left.src, leftTitle: left.title, rightGroupId: group.id, rightIndex: index + 1, rightSrc: right ? right.src : '', rightTitle: right ? right.title : '' })
  }
  return rows
}

export default {
  private: { groups: [], selectedGroup: null, rows: [], pickerVisible: false },
  onInit() { this.groups = getCgGroups(); this.selectGroup(0) },
  selectGroup(index) {
    const group = this.groups[Number(index)]
    if (!group) return
    this.selectedGroup = group
    this.rows = makeRows(group)
    this.pickerVisible = false
  },
  togglePicker() { this.pickerVisible = !this.pickerVisible },
  openItem(groupId, index) { router.push({ uri: 'pages/cg-viewer', params: { groupId, index: String(index) } }) },
  back() { router.back() },
  blockSystemBack() {}
}
</script>

<style>

.page { width: 233px; height: 233px; overflow: hidden; background-color: #17151a; flex-direction: column; align-items: center; }
.page-title { position: absolute; top: 0px; left: 0px; width: 233px; height: 23.3px; line-height: 23.3px; color: #ffffff; font-size: 12.1px; font-weight: bold; text-align: center; }
.chapter-picker { position: absolute; top: 24.2px; left: 15.39px; width: 202.23px; height: 18.82px; line-height: 18.82px; background-color: #b95079; color: #ffffff; font-size: 8.51px; font-weight: bold; text-align: center; border-radius: 4.48px; }
.content { position: absolute; top: 45.7px; left: 8.79px; width: 215.42px; height: 160.41px; overflow: hidden; }
.group-title-item { width: 215.42px; height: 13.44px; }
.group-title { width: 215.42px; height: 13.44px; line-height: 13.44px; color: #e08db1; font-size: 8.96px; font-weight: bold; }
.thumb-row { width: 215.42px; height: 54.67px; margin-top: 3.58px; flex-direction: row; justify-content: space-between; }
.thumb-cell { width: 103.31px; height: 54.67px; background-color: #2c2730; border-radius: 3.14px; flex-direction: column; align-items: center; }
.thumb { width: 98.92px; height: 42.12px; margin-top: 0.9px; object-fit: contain; }
.thumb-empty { width: 98.92px; height: 42.12px; margin-top: 0.9px; line-height: 42.12px; color: #aaa1aa; font-size: 5.83px; text-align: center; }
.thumb-title { width: 98.92px; height: 10.75px; line-height: 10.75px; color: #f5e1e8; font-size: 5.83px; text-align: center; text-overflow: ellipsis; lines: 1; }
.back-btn { position: absolute; bottom: 3.58px; left: 41.76px; width: 149.47px; height: 17.03px; line-height: 17.03px; color: #ffffff; font-size: 8.07px; font-weight: bold; text-align: center; background-color: #302b33; border-radius: 4.48px; z-index: 8; }
.picker-scrim { position: absolute; top: 0px; left: 0px; width: 233px; height: 233px; background-color: #000000; opacity: 0.72; }
.picker { position: absolute; top: 25.99px; left: 17.58px; width: 197.83px; padding: 4.48px 0px; background-color: #2c2730; border-radius: 5.38px; flex-direction: column; align-items: center; }
.picker-title { width: 175.85px; height: 12.55px; line-height: 12.55px; color: #ffd8e6; font-size: 8.51px; font-weight: bold; text-align: center; }
.picker-option { width: 175.85px; height: 15.23px; line-height: 15.23px; margin-top: 1.79px; background-color: #412536; color: #ffffff; font-size: 7.62px; font-weight: bold; text-align: center; border-radius: 3.58px; }
.back-btn { bottom: 3px; left: 29px; width: 175px; height: 25px; line-height: 25px; font-size: 11px; border-radius: 8px; }
.person-single { top: 2px; bottom: auto; left: -19.81px; width: 272.61px; height: 360px; }
.person-duo-left { top: 0px; bottom: auto; left: -62.91px; width: 251.64px; height: 360px; }
.person-duo-right { top: 0px; bottom: auto; left: 62.91px; width: 251.64px; height: 360px; }
.person-trio-left { top: 0px; bottom: auto; left: -67.57px; width: 233.0px; height: 342px; }
.person-trio-center { top: 0px; bottom: auto; left: -4.66px; width: 233.0px; height: 342px; }
.person-trio-right { top: 0px; bottom: auto; left: 62.91px; width: 233.0px; height: 342px; }
</style>
