<template>
  <div class="page" @swipe="blockSystemBack">
    <text class="page-title">CG鉴赏</text>
    <text class="chapter-picker" @click="togglePicker">章节：{{selectedGroup ? selectedGroup.title : '选择章节'}}</text>
    <list class="content">
      <list-item type="group" class="group-title-item" if="{{selectedGroup}}"><text class="group-title">{{selectedGroup.title}}</text></list-item>
      <list-item type="thumb" class="thumb-row" for="{{rows}}">
        <div class="thumb-cell" if="{{$item.leftTitle}}" @click="openItem($item.leftGroupId, $item.leftIndex)">
          <image class="thumb" src="{{$item.leftSrc}}" if="{{$item.leftSrc}}"></image>
          <text class="thumb-empty" if="{{!$item.leftSrc}}">暂无图像</text>
          <text class="thumb-title">{{$item.leftTitle}}</text>
        </div>
        <div class="thumb-cell" if="{{$item.rightTitle}}" @click="openItem($item.rightGroupId, $item.rightIndex)">
          <image class="thumb" src="{{$item.rightSrc}}" if="{{$item.rightSrc}}"></image>
          <text class="thumb-empty" if="{{!$item.rightSrc}}">暂无图像</text>
          <text class="thumb-title">{{$item.rightTitle}}</text>
        </div>
      </list-item>
    </list>
    <text class="back-btn" @click="back">返回</text>
    <div class="picker-scrim" if="{{pickerVisible}}" @click="togglePicker"></div>
    <div class="picker" if="{{pickerVisible}}">
      <text class="picker-title">选择章节</text>
      <text class="picker-option" for="{{groups}}" @click="selectGroup($idx)">{{$item.title}}</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { getCgGroups } from '../../common/cg-catalog.js'

function makeRows(group) {
  const rows = []
  for (let index = 0; index < group.items.length; index += 2) {
    const left = group.items[index]
    const right = group.items[index + 1]
    rows.push({ leftGroupId: group.id, leftIndex: index, leftSrc: left.src, leftTitle: left.title, rightGroupId: group.id, rightIndex: index + 1, rightSrc: right ? right.src : '', rightTitle: right ? right.title : '' })
  }
  return rows
}

export default {
  private: { groups: [], selectedGroup: null, rows: [], pickerVisible: false },
  onInit() { this.groups = getCgGroups(); this.selectGroup(0) },
  selectGroup(index) {
    const group = this.groups[Number(index)]
    if (!group) return
    this.selectedGroup = group
    this.rows = makeRows(group)
    this.pickerVisible = false
  },
  togglePicker() { this.pickerVisible = !this.pickerVisible },
  openItem(groupId, index) { router.push({ uri: 'pages/cg-viewer', params: { groupId, index: String(index) } }) },
  back() { router.back() },
  blockSystemBack() {}
}
</script>

<style>
.page { width: 212px; height: 520px; overflow: hidden; background-color: #17151a; flex-direction: column; align-items: center; }
.page-title { position: absolute; top: 0px; left: 0px; width: 212px; height: 52px; line-height: 52px; color: #ffffff; font-size: 27px; font-weight: bold; text-align: center; }
.chapter-picker { position: absolute; top: 54px; left: 14px; width: 184px; height: 42px; line-height: 42px; background-color: #b95079; color: #ffffff; font-size: 19px; font-weight: bold; text-align: center; border-radius: 10px; }
.content { position: absolute; top: 102px; left: 8px; width: 196px; height: 358px; overflow: hidden; }
.group-title-item { width: 196px; height: 30px; }
.group-title { width: 196px; height: 30px; line-height: 30px; color: #e08db1; font-size: 20px; font-weight: bold; }
.thumb-row { width: 196px; height: 122px; margin-top: 8px; flex-direction: row; justify-content: space-between; }
.thumb-cell { width: 94px; height: 122px; background-color: #2c2730; border-radius: 7px; flex-direction: column; align-items: center; }
.thumb { width: 90px; height: 94px; margin-top: 2px; object-fit: contain; }
.thumb-empty { width: 90px; height: 94px; margin-top: 2px; line-height: 94px; color: #aaa1aa; font-size: 13px; text-align: center; }
.thumb-title { width: 90px; height: 24px; line-height: 24px; color: #f5e1e8; font-size: 13px; text-align: center; text-overflow: ellipsis; lines: 1; }
.back-btn { position: absolute; bottom: 8px; left: 38px; width: 136px; height: 38px; line-height: 38px; color: #ffffff; font-size: 18px; font-weight: bold; text-align: center; background-color: #302b33; border-radius: 10px; z-index: 8; }
.picker-scrim { position: absolute; top: 0px; left: 0px; width: 212px; height: 520px; background-color: #000000; opacity: 0.72; }
.picker { position: absolute; top: 58px; left: 16px; width: 180px; padding: 10px 0px; background-color: #2c2730; border-radius: 12px; flex-direction: column; align-items: center; }
.picker-title { width: 160px; height: 28px; line-height: 28px; color: #ffd8e6; font-size: 19px; font-weight: bold; text-align: center; }
.picker-option { width: 160px; height: 34px; line-height: 34px; margin-top: 4px; background-color: #412536; color: #ffffff; font-size: 17px; font-weight: bold; text-align: center; border-radius: 8px; }
@media (shape: rect) {
  .page { width: 212px; height: 303px; }
  .page-title { height: 31px; line-height: 31px; font-size: 19px; }
  .chapter-picker { top: 33px; height: 26px; line-height: 26px; font-size: 14px; }
  .content { top: 63px; height: 204px; }
  .group-title-item, .group-title { height: 19px; }
  .group-title { line-height: 19px; font-size: 14px; }
  .thumb-row { height: 68px; margin-top: 4px; }
  .thumb-cell { height: 68px; }
  .thumb { height: 49px; }
  .thumb-empty { height: 49px; line-height: 49px; font-size: 9px; }
  .thumb-title { height: 15px; line-height: 15px; font-size: 9px; }
  .back-btn { bottom: 3px; left: 38px; width: 136px; height: 26px; line-height: 26px; font-size: 14px; border-radius: 8px; }
  .picker-scrim { height: 303px; }
  .picker { top: 36px; }
  .picker-title { height: 22px; line-height: 22px; font-size: 15px; }
  .picker-option { height: 22px; line-height: 22px; font-size: 13px; }
}
@media (shape: circle) { .back-btn { bottom: 3px; left: 29px; width: 175px; height: 25px; line-height: 25px; font-size: 11px; border-radius: 8px; } }
</style>


